:"post-hoc","type":"twin","label":null,"bridge":null},{"from":"regression-to-mean","to":"post-hoc","type":"bridge","label":null,"bridge":null},{"from":"publication-bias","to":"replication-crisis","type":"bridge","label":null,"bridge":null},{"from":"publication-bias","to":"survivorship-bias","type":"twin","label":null,"bridge":null},{"from":"opportunity-cost","to":"sunk-cost","type":"bridge","label":null,"bridge":null},{"from":"loss-aversion","to":"sunk-cost","type":"depth","label":null,"bridge":null},{"from":"loss-aversion","to":"expected-value","type":"bridge","label":null,"bridge":null},{"from":"escalation-of-commitment","to":"sunk-cost","type":"twin","label":null,"bridge":null},{"from":"expected-value","to":"loss-aversion","type":"bridge","label":null,"bridge":null},{"from":"nash-equilibrium","to":"prisoners-dilemma","type":"depth","label":null,"bridge":null},{"from":"nash-equilibrium","to":"chicken","type":"depth","label":null,"bridge":null},{"from":"tit-for-tat","to":"prisoners-dilemma","type":"foundation","label":null,"bridge":null},{"from":"brinkmanship","to":"chicken","type":"foundation","label":null,"bridge":null},{"from":"brinkmanship","to":"mad","type":"bridge","label":null,"bridge":null},{"from":"credible-commitment","to":"chicken","type":"foundation","label":null,"bridge":null},{"from":"credible-commitment","to":"brinkmanship","type":"twin","label":null,"bridge":null},{"from":"free-rider","to":"tragedy-of-the-commons","type":"twin","label":null,"bridge":null},{"from":"free-rider","to":"prisoners-dilemma","type":"foundation","label":null,"bridge":null},{"from":"occams-razor","to":"falsifiability","type":"bridge","label":null,"bridge":null},{"from":"inversion","to":"survivorship-bias","type":"bridge","label":null,"bridge":null},{"from":"problem-of-induction","to":"falsifiability","type":"depth","label":null,"bridge":null},{"from":"problem-of-induction","to":"black-swan","type":"depth","label":null,"bridge":null},{"from":"black-swan","to":"falsifiability","type":"foundation","label":null,"bridge":null},{"from":"black-swan","to":"problem-of-induction","type":"foundation","label":null,"bridge":null},{"from":"externality","to":"tragedy-of-the-commons","type":"depth","label":null,"bridge":null},{"from":"mad","to":"chicken","type":"foundation","label":null,"bridge":null},{"from":"mad","to":"credible-commitment","type":"bridge","label":null,"bridge":null},{"from":"replication-crisis","to":"publication-bias","type":"foundation","label":null,"bridge":null},{"from":"replication-crisis","to":"falsifiability","type":"bridge","label":null,"bridge":null},{"from":"streisand-effect","to":"backfire-effect","type":"twin","label":null,"bridge":null},{"from":"cobra-effect","to":"goodharts-law","type":"twin","label":null,"bridge":null},{"from":"goodharts-law","to":"cobra-effect","type":"twin","label":null,"bridge":null},{"from":"goodharts-law","to":"replication-crisis","type":"bridge","label":null,"bridge":null},{"from":"pyrrhic-victory","to":"sunk-cost","type":"bridge","label":null,"bridge":null},{"from":"monty-hall","to":"conjunction-fallacy","type":"bridge","label":null,"bridge":null}],"concepts":{},"cards":{},"samples":{"firstfall":{"id":"linda","concept":"conjunction-fallacy","title":"בעיית לינדה","setup":"לינדה בת 31, רווקה, דעתנית ומבריקה מאוד. בתואר הראשון היא למדה פילוסופיה. כסטודנטית העסיקו אותה מאוד סוגיות של אפליה וצדק חברתי, והיא גם השתתפה בהפגנות נגד הגרעין. איזו משתי האפשרויות סבירה יותר?","options":["לינדה היא כספרית בבנק.","לינדה היא כספרית בבנק ופעילה בתנועה הפמיניסטית."],"intuitive":1,"answer":0,"reveal":"במאמר מ־1983 דיווחו עמוס טברסקי ודניאל כהנמן שהציגו את השאלה הזו ל־142 סטודנטים לתואר ראשון באוניברסיטת בריטיש קולומביה, ו־85% מהם בחרו באפשרות השנייה. אבל היא לא יכולה להיות סבירה יותר: כל כספרית בבנק שפעילה בתנועה הפמיניסטית היא גם כספרית בבנק. לכן הסיכוי ששני דברים נכונים יחד לא יכול להיות גבוה מהסיכוי של כל אחד מהם לבד. התיאור נבנה בכוונה כך שלינדה תתאים לדמות של פמיניסטית ולא לדמות של כספרית בבנק, ולכן הצירוף מרגיש מתאים יותר. החוקרים קראו לטעות הזו כשל הצירוף, והסבירו אותה בהיוריסטיקת הייצוגיות: אנחנו שופטים לפי הדמיון לדמות, ולא לפי ההסתברות. הם גם ניסו לחלץ את הנבדקים מהמלכודת. כשקבוצה אחרת התבקשה לבחור על מה להמר כדי לזכות ב־10 דולר, 56% עדיין הימרו על הצירוף.","sourceIds":["s1"]},"debate":{"title":"שבוע של ארבעה ימים?","topic":"שבוע עבודה של ארבעה ימים","intro":"בישיבת צוות עולה הצעה לנסות שבוע עבודה של ארבעה ימים. אתה בעד ניסוי זהיר. הסופיסט נגד, והוא רוצה לנצח יותר משהוא רוצה להיות צודק. בחלק מהתורות שלו מסתתר כשל. כשאתה מזהה אחד, לחץ “תפסתי כשל”. לכינוי “סופיסט” יש היסטוריה: המחקר השיטתי הראשון הידוע על כשלים הוא החיבור של אריסטו “הפרכות סופיסטיות”, ובו הוא מנה 13 סוגים.","turns":[{"who":"me","text":"אני מציע לנסות שבוע עבודה של ארבעה ימים, לשלושה חודשים, בצוותים שזה מתאים להם. נמדוד תפוקה, עמידה בלוחות זמנים ושביעות רצון של לקוחות, ונחליט לפי התוצאות.","fallacy":null},{"who":"sophist","text":"כלומר אתה רוצה שנשלם משכורת מלאה לאנשים שיעבדו פחות ויספקו פחות. נשמע נהדר לעובדים. לחברה, פחות.","fallacy":"strawman","options":["ad-hominem","false-dilemma","strawman","post-hoc"],"feedback":"הצעת ניסוי קצר עם מדידת תפוקה, והסופיסט תקף הצעה אחרת: לשלם על פחות תוצרים. זה איש קש: מייחסים ליריב עמדה שהוא לא מחזיק בה וקל להפריך, ואז מפריכים אותה. זה לא אד הומינם, כי הוא תקף עמדה ולא אותך. רק שהעמדה הזו לא שלך.","sourceIds":["s2","s3"]},{"who":"me","text":"לא אמרתי לספק פחות. השאלה היא בדיוק אם אפשר לספק אותו דבר בארבעה ימים. בשביל זה מודדים, ואם התפוקה יורדת, מפסיקים.","fallacy":null},{"who":"sophist","text":"בסדר, אז הנה בעיה אמיתית: לקוחות מתקשרים אלינו מראשון עד חמישי. אם צוות התמיכה חסר יום, מישהו ישלם על זה.","fallacy":null},{"who":"me","text":"נקודה טובה. אפשר לחלק את הצוות: חצי לא עובדים בראשון וחצי לא עובדים בחמישי, כך שתמיד יש מענה. ואם גם זה לא מסתדר, התמיכה פשוט לא תיכנס לניסוי.","fallacy":null},{"who":"sophist","text":"תראה, בעולם תחרותי יש רק שתי דרכים: או שעובדים יותר שעות מהמתחרים, או שנעלמים מהשוק. אין דרך שלישית.","fallacy":"false-dilemma","options":["strawman","false-dilemma","post-hoc","sunk-cost"],"feedback":"הסופיסט הציג רק שתי אפשרויות, כאילו חייבים לבחור ביניהן: יותר שעות, או להיעלם. בפועל יש עוד דרכים להתחרות: לעבוד ביעילות רבה יותר, לבחור טוב יותר במה להשקיע, או בדיוק מה שהניסוי בודק, לספק אותו דבר בפחות שעות. זו דילמה כוזבת. זה לא איש קש, כי הוא לא ייחס לך עמדה. הוא צמצם את כל האפשרויות לשתיים.","sourceIds":["s2","s3"]},{"who":"me","text":"יש לפחות דרך שלישית: לספק אותו דבר בפחות שעות, למשל עם פחות ישיבות מיותרות. אולי זה לא יעבוד אצלנו, אבל זה בדיוק מה שהניסוי יבדוק.","fallacy":null},{"who":"sophist","text":"אז תשמע מה קרה בחברה של אח שלי. הם עברו לארבעה ימים בינואר, ובמרץ איבדו את הלקוח הכי גדול שלהם. זה מה שקורה כשמתחילים עם הרעיונות האלה.","fallacy":"post-hoc","options":["survivorship-bias","strawman","false-dilemma","post-hoc"],"feedback":"כל הטיעון נשען על הסדר בזמן: קודם המעבר לארבעה ימים, ואחר כך עזיבת הלקוח. סדר בזמן יכול להיות רמז, אבל הקפיצה ממנו ישר ל“בגללו” היא הכשל “אחריו, לכן בגללו”. הלקוח יכול היה לעזוב בגלל מחיר, מתחרה או שינוי אצלו, ובלי לבדוק את זה אי אפשר לדעת. זו לא הטיית השורדים, כי אף אחד כאן לא מסיק מסקנה רק ממי שעבר סינון. וחוץ מזה, זה מקרה אחד.","sourceIds":["s2","s3","s4"]},{"who":"me","text":"אולי. ואולי הלקוח עזב בגלל המחיר, בגלל מתחרה חדש או בגלל שינוי אצלו. זה שדבר אחד קרה אחרי השני לא אומר שהראשון גרם לשני. מישהו בכלל שאל את הלקוח למה הוא עזב?","fallacy":null},{"who":"sophist","text":"בוא, אתה מגיע כל בוקר בעשר ויוצא ראשון. ברור למה הרעיון הזה מוצא חן בעיניך. אז סליחה שאני לא מתרגש מהניתוח שלך.","fallacy":"ad-hominem","options":["ad-hominem","post-hoc","strawman","false-dilemma"],"feedback":"במקום להתמודד עם הטיעון, הסופיסט תוקף אותך: מתי אתה מגיע, ואיזה אינטרס יש לך. גם אם הכול נכון, זה לא משנה מה יראו המספרים בעוד שלושה חודשים. זה אד הומינם: התקפה לא רלוונטית על הדובר, כאילו היא מפריכה את הטיעון. ולא כל הערה אישית היא כשל: כשמסתמכים על העדות או על הסמכות של אדם, האמינות שלו רלוונטית. כאן הטענה נבדקת במדידה, לא באופי שלך. זה גם לא איש קש, כי הוא לא עיוות את ההצעה. הוא פשוט עקף אותה.","sourceIds":["s2","s3"]},{"who":"me","text":"נניח שאני באמת רוצה יום חופש. זה לא הופך את הטיעון שלי לנכון או לשגוי. בגלל זה הצעתי למדוד, ולא לסמוך עליי או עליך.","fallacy":null},{"who":"sophist","text":"אז תסביר לי משהו. כשחברה נקלעת לקשיים, היא מקצצת בימי עבודה, נכון? המתחרה הכי גדול שלנו עבר עכשיו לארבעה ימים. כלומר הוא בקשיים. ואתה רוצה שנלך בעקבותיו?","fallacy":"affirming-the-consequent","options":["denying-the-antecedent","false-dilemma","affirming-the-consequent","post-hoc"],"feedback":"המבנה כאן: “אם חברה בקשיים, היא מקצצת בימי עבודה. המתחרה קיצץ. לכן הוא בקשיים.” זה אישור התוצאה: מכך שהתוצאה (קיצוץ) התקיימה, מסיקים שהרישא (קשיים) התקיימה. זה כשל צורני: המבנה עצמו פסול, בלי קשר לנושא. ובמקרה הזה קל לראות למה: לקיצוץ יש עוד סיבות אפשריות, למשל ניסוי כמו שאתה מציע. שלילת הרישא היא הכשל התאום: “הוא לא בקשיים, לכן הוא לא יקצץ.” גם היא לא תקפה, אבל זה לא מה שנאמר כאן.","sourceIds":["s2"]},{"who":"me","text":"יש עוד סיבות לקצץ ימים. אולי הם בודקים בדיוק את מה שאני מציע. “אם בקשיים, אז מקצצים” לא אומר “אם מקצצים, אז בקשיים”.","fallacy":null},{"who":"sophist","text":"טוב, אני מוכן לניסוי, בתנאי אחד: נקבע מראש איזו תוצאה תחזיר אותנו לחמישה ימים. אחרת כל אחד יקרא את המספרים כמו שנוח לו.","fallacy":null}],"outro":"הסופיסט השחיל חמישה כשלים, אבל העלה גם שתי נקודות טובות: זמינות ללקוחות, וקביעה מראש של התוצאה שתעצור את הניסוי. וזה העיקר: כשל פוסל את הטיעון, לא בהכרח את המסקנה, כי גם מנימוק גרוע אפשר להגיע לאמת. ייתכן שאצלכם שבוע של ארבעה ימים באמת לא יעבוד, והניסוי הוא הדרך לגלות. וגם בצד שבעד יש כשלים: “כל החברות שעדיין עובדות ככה מרוצות, אז זה עובד” מתעלם מהחברות שכבר חזרו לחמישה ימים. זו הטיית השורדים.","sourceIds":["s2","s3","s4"]},"eli10":{"concept":"survivorship-bias","prompt":"תסביר מהי הטיית השורדים כאילו אתה מדבר עם ילד בן 10: במילים פשוטות, עם דוגמה שהוא יכול לדמיין, ובסוף משפט אחד על מה עושים עם זה.","sampleAnswer":"הטיית השורדים זה כשמסתכלים רק על מי שהצליח ושוכחים את מי שנכשל. למשל, במלחמת העולם השנייה בדקו את המטוסים שחזרו מקרבות, וראו שבמקומות מסוימים יש הרבה חורים מפגיעות. אז רצו לחזק דווקא את המקומות האלה. אבל מתמטיקאי בשם אברהם ואלד הבין שהחורים מראים איפה מטוס יכול להיפגע ועדיין לחזור. מטוסים שנפגעו במקומות אחרים נפלו יותר, אז פחות מהחורים האלה הגיעו לבדיקה. המסקנה: תמיד צריך לעשות את ההפך ממה שהנתונים מראים, ולחזק דווקא איפה שאין חורים.","feedback":{"score":3,"of":5,"strengths":["הפתיחה מגדירה את ההטיה במשפט אחד, בלי מילים קשות.","דוגמת המטוסים תופסת את לב העניין: מטוסים שנפגעו במקומות המסוכנים חזרו פחות, ולכן הפגיעות האלה נספרו פחות.","משפטים קצרים וברורים. אפשר להקריא את זה לילד בקול."],"missing":["דוגמה מהעולם של ילד בן 10. מלחמה ומטוסים רחוקים ממנו; צעצועים, משחקים או בית ספר יעבדו טוב יותר.","מה עושים עם זה: לשאול “מי לא הגיע לכאן, ולמה?” לפני שמסיקים משהו ממי שכן הגיע."],"misconception":"המשפט האחרון, “תמיד צריך לעשות את ההפך ממה שהנתונים מראים”, הוא כלל שגוי. הלקח הוא לא להפוך את הנתונים, אלא לשאול איך הם נאספו ומי חסר בהם. גם ואלד לא פשוט “הפך”: השיטה שלו נשענה על הנחה לגבי האופן שבו הפגיעות היו מתפזרות על המטוס אילו אף מטוס לא היה הולך לאיבוד. לפי אלן וואליס, שעמד בראש קבוצת המחקר הסטטיסטי שבה עבד ואלד, הוא הניח על סמך ראיות שהפגיעות מתפזרות באופן אחיד. רק בזכות ההנחה הזו, מעט חורים באזור מסוים במטוסים שחזרו לימדו שפגיעה שם מסוכנת. בלי הנחה כזו, “ההפך” יכול להטעות בדיוק כמו הנתונים עצמם.","improved":"דמיין שסבתא אומרת: “פעם צעצועים היו חזקים יותר. תראה, הצעצועים מהילדות שלי עדיין עובדים!” אבל רגע: את כל הצעצועים שנשברו זרקו מזמן. נשארו רק החזקים, ולכן נדמה לה שכולם היו כאלה.\n\nזו הטיית השורדים: כשמסתכלים רק על מה ש“שרד”, ולא רואים את כל מה שנעלם בדרך, מגיעים למסקנה לא נכונה.\n\nזה קרה גם במלחמת העולם השנייה. במטוסים שחזרו מקרב ראו הרבה חורים במקומות מסוימים, והייתה נטייה לחזק דווקא אותם. מתמטיקאי בשם אברהם ואלד הבין שהחורים האלה מראים איפה מטוס יכול להיפגע ועדיין לחזור. מטוסים שנפגעו במקומות המסוכנים באמת חזרו פחות, ולכן רואים שם פחות חורים.\n\nאז כשמישהו אומר “כל מי שעשה ככה הצליח”, תשאל: ומה עם אלה שעשו ככה ולא הצליחו? איפה הם?"},"rubric":["מגדיר את ההטיה במשפט פשוט: מסקנה שנשענת רק על מה ששרד, כאילו הוא מייצג את הכול.","מסביר למה מה שנעלם חסר בתמונה, ואיך זה מעוות את המסקנה.","משתמש בדוגמה מהעולם של ילד בן 10.","אומר מה עושים עם זה: שואלים מי חסר בתמונה, ולמה.","כתוב בשפה של ילד: משפטים קצרים, בלי מונחים קשים."],"sourceIds":["s4","s5"]},"sources":[{"id":"s1","kind":"paper","citation":"Tversky, A., & Kahneman, D. (1983). Extensional versus intuitive reasoning: The conjunction fallacy in probability judgment. Psychological Review, 90(4), 293–315. https://doi.org/10.1037/0033-295X.90.4.293","url":"https://pages.ucsd.edu/~mckenzie/TverskyKahneman1983PsychRev.pdf","lang":"en"},{"id":"s2","kind":"encyclopedia","citation":"Dowden, B. Fallacies. Internet Encyclopedia of Philosophy (ISSN 2161-0002). Entries: Straw Man, False Dilemma, Black-or-White, Post Hoc, Ad Hominem, Affirming the Consequent, Denying the Antecedent; Introduction.","url":"https://iep.utm.edu/fallacy/","lang":"en"},{"id":"s3","kind":"encyclopedia","citation":"Hansen, H. Fallacies. The Stanford Encyclopedia of Philosophy (first published 29 May 2015; substantive revision 30 August 2024).","url":"https://plato.stanford.edu/entries/fallacies/","lang":"en"},{"id":"s4","kind":"article","citation":"Casselman, B. (2016, June). The Legend of Abraham Wald. Feature Column, American Mathematical Society. Includes W. Allen Wallis's 1980 rejoinder in JASA on the military's inclination and Wald's assumption of uniformly distributed hits.","url":"https://www.ams.org/publicoutreach/feature-column/fc-2016-06","lang":"en"},{"id":"s5","kind":"paper","citation":"Mangel, M., & Samaniego, F. J. (1984). Abraham Wald's Work on Aircraft Survivability. Journal of the American Statistical Association, 79(386), 259–267. https://doi.org/10.2307/2288257 (scanned copy hosted by the first author; abstract at https://www.jstor.org/stable/2288257).","url":"https://people.ucsc.edu/~msmangel/Wald.pdf","lang":"en"}],"draft":false},"verification":{"confirmation-bias":{"status":"missing","round":1,"date":"2026-10-24","claims":135,"verified":130,"corrected":0,"removed":0,"open":5},"sunk-cost":{"status":"missing","round":null,"date":null,"claims":0,"verified":0,"corrected":0,"removed":0,"open":null},"affirming-the-consequent":{"status":"missing","round":null,"date":null,"claims":0,"verified":0,"corrected":0,"removed":0,"open":null},"survivorship-bias":{"status":"missing","round":1,"date":"2026-10-24","claims":80,"verified":77,"corrected":0,"removed":0,"open":3},"prisoners-dilemma":{"status":"missing","round":1,"date":"2026-10-24","claims":83,"verified":81,"corrected":0,"removed":0,"open":2},"falsifiability":{"status":"missing","round":null,"date":null,"claims":0,"verified":0,"corrected":0,"removed":0,"open":null},"chicken":{"status":"missing","round":null,"date":null,"claims":0,"verified":0,"corrected":0,"removed":0,"open":null},"tragedy-of-the-commons":{"status":"missing","round":null,"date":null,"claims":0,"verified":0,"corrected":0,"removed":0,"open":null},"cards-a":{"status":"missing","round":null,"date":null,"claims":0,"verified":0,"corrected":0,"removed":0,"open":null},"cards-b":{"status":"missing","round":null,"date":null,"claims":0,"verified":0,"corrected":0,"removed":0,"open":null},"cards-c":{"status":"missing","round":null,"date":null,"claims":0,"verified":0,"corrected":0,"removed":0,"open":null},"samples":{"status":"passed","round":1,"date":"2026-10-24","claims":36,"verified":36,"corrected":0,"removed":0,"open":0}}}